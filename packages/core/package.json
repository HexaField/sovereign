  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fold-system-events": {
      "types": "./src/fold-system-events.ts",
      "development": "./src/fold-system-events.ts",
      "default": "./dist/fold-system-events.js"
    },
    "./ask-user-question": {
      "types": "./src/ask-user-question.ts",
      "development": "./src/ask-user-question.ts",
      "default": "./dist/ask-user-question.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./fold-system-events": "./dist/fold-system-events.js",
      "./ask-user-question": "./dist/ask-user-question.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  }
