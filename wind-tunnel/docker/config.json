{
  "server": {
    "host": "0.0.0.0",
    "port": 5801,
    "tls": {
      "enabled": false
    }
  },
  "personality": {
    "sourceDir": "",
    "files": [],
    "separator": ""
  },
  "contextManagement": {
    "recycle": {
      "enabled": true,
      "thresholdPercent": 1,
      "minIntervalMs": 0,
      "prescription": "standard",
      "skipDuringSubagents": true
    },
    "cleanup": {
      "enabled": true,
      "maxSessionSizeMB": 0.004,
      "schedule": "0 4 * * *"
    }
  },
  "agentBackend": {
    "enabled": ["claude-code", "local-llm"],
    "default": "claude-code",
    "localLlm": {
      "baseUrl": "http://mock-llm:8900",
      "model": "default",
      "contextWindow": 32768,
      "temperature": 0.1,
      "maxTokens": 4096,
      "toolCallFormat": "auto",
      "sandbox": {
        "allowedCwds": []
      }
    }
  },
  "voice": {
    "transcribeUrl": "http://mock-llm:8900/mock/transcribe",
    "ttsUrl": "http://mock-llm:8900/synthesize",
    "autoTts": true,
    "ackDelayMs": 0,
    "conversationSummary": true
  },
  "summary": {
    "enabled": true,
    "baseUrl": "http://mock-llm:8900",
    "model": "default",
    "debounceMs": 500,
    "maxSummaryWords": 100
  }
}
