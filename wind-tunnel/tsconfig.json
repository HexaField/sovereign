{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "../node_modules/@types"],
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "mock-llm/**/*.ts"]
}
